[Unit]
Description=Hy2 Panel (Hysteria2 admin panel)
After=network-online.target
Wants=network-online.target

[Service]
User=hy2panel
Group=hy2panel
WorkingDirectory=/opt/hy2panel
ExecStart=/opt/hy2panel/.venv/bin/python run.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hy2panel/data

[Install]
WantedBy=multi-user.target

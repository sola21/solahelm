# Скопируйте в .env и поправьте под себя.

# Адреса через nginx:
#   клиенты (кабинет, подписки):  https://panel.example.com/hy/
#   админка:                      https://panel.example.com/hy/admin/
# HY_BASE_PATH — публичный префикс, HY_ADMIN_PATH — подпапка админки внутри него.
# Установщик при первой установке подставляет СЛУЧАЙНЫЕ значения (так панель не находят сканеры по известным путям),
# а новый случайный адрес админки можно получить командой: sudo ROTATE_ADMIN_PATH=1 bash deploy/install-linux.sh
HY_BASE_PATH=/hy
HY_ADMIN_PATH=admin

# Прежние префиксы (через запятую), если панель раньше жила по другому адресу, например /hy-admin.
# Подписки по старым ссылкам продолжат работать, остальные страницы перенаправятся на новые адреса.
# HY_LEGACY_BASE=/hy-admin
# По старому префиксу страницы админки НЕ перенаправляются (иначе адрес админки раскрылся бы любому); включить: 1
# HY_LEGACY_ADMIN_REDIRECT=0

# На каком адресе слушает приложение.
# Если nginx на этой же машине — 127.0.0.1.
# Если панель на другой машине в LAN 192.168.1.0/24 — IP этой машины, например 192.168.1.20.
HY_HOST=127.0.0.1
HY_PORT=8088

# IP nginx (reverse proxy), которому доверяем X-Real-IP / X-Forwarded-Proto.
# Если nginx на другой машине — укажите её LAN-IP, например 192.168.1.1.
HY_TRUSTED_PROXIES=127.0.0.1,::1

# Публичный адрес (кабинет клиентов и ссылки подписки; можно задать и в настройках панели).
HY_PUBLIC_URL=https://panel.example.com/hy

# Название продукта в интерфейсе (шапка, заголовки, подвал).
# HY_BRAND=SolaHelm

# Язык интерфейса по умолчанию: ru | en | auto (по языку браузера). Переключатель RU | EN есть на каждой странице,
# выбор пользователя запоминается в cookie.
HY_DEFAULT_LANG=auto

# Интервал опроса VPS, секунды.
HY_POLL_INTERVAL=60

# Время жизни сессии администратора, часы.
HY_SESSION_HOURS=12

# Флаг Secure у cookie: auto (по X-Forwarded-Proto) | 1 | 0
HY_COOKIE_SECURE=auto

# Каталог данных (БД, ключи). По умолчанию ./data
# HY_DATA_DIR=C:\hy2panel\data
